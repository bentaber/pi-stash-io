{
	"name": "pi-stash-io",
	"version": "0.1.0",
	"description": "Stash prompt drafts with Alt+S and pop them with Alt+Shift+S in Pi.",
	"type": "module",
	"author": "Ben Taber",
	"license": "MIT",
	"keywords": [
		"pi-package",
		"pi",
		"pi-extension",
		"stash",
		"prompt",
		"draft"
	],
	"engines": {
		"node": ">=24.0.0"
	},
	"files": [
		"extensions",
		"assets",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public"
	},
	"pi": {
		"extensions": [
			"./extensions/stash.ts"
		]
	},
	"scripts": {
		"test": "node --test test/*.test.ts",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"smoke": "node scripts/smoke.mjs",
		"check": "npm run lint && npm run typecheck && npm test && npm run smoke && npm pack --dry-run",
		"prepublishOnly": "npm run check"
	},
	"dependencies": {
		"proper-lockfile": "^4.1.2"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"@earendil-works/pi-tui": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@earendil-works/pi-coding-agent": "1.0.0",
		"@earendil-works/pi-tui": "1.0.0",
		"@types/node": "24.19.1",
		"@types/proper-lockfile": "4.1.4",
		"typescript": "7.0.2"
	}
}
